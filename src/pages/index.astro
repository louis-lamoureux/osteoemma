---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import { site } from '../data/site';
import portrait from '../assets/provider.png';
import { localePath, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout title={t('titleHome')} current="home" lang={lang}>
<main>
<section style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 80px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px">
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<span style="display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46"><span style="width: 28px; height: 2px; background: #7A5C46; border-radius: 2px"></span>{t('homeEyebrow')}</span>
<h1 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(42px, 5.4vw, 74px); line-height: 1.04; letter-spacing: -0.015em; color: #33503F">{t('homeHeadline')} <em style="font-style: italic; color: #7A5C46">{t('homeHeadlineEmphasis')}</em></h1>
<p style="margin: 0; font-size: 19px; max-width: 520px; color: #4A463E">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam eaque ipsa quae ab illo inventore.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px">
<a href={site.goRendezVousUrl} data-book-now style="display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; border-radius: 999px; background: #33503F; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px">{t('seeAvailabilities')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
<a href={localePath('/osteopathy', lang)} style="display: inline-flex; align-items: center; padding: 16px 26px; border-radius: 999px; border: 1.5px solid #9DB394; color: #33503F; text-decoration: none; font-weight: 600; font-size: 16px">{t('whatIsOsteopathy')}</a>
</div>
</div>
<div style="flex: 1 1 380px; min-width: 0; position: relative; display: flex; justify-content: center">
<div style="width: 85%; max-width: 391px; aspect-ratio: 4 / 5; border-radius: 58% 42% 47% 53% / 46% 52% 48% 54%; background: #F6F3EC; position: relative; overflow: hidden">
<img src={portrait.src} width={portrait.width} height={portrait.height} alt={site.name} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%">
<div aria-hidden="true" style="position: absolute; inset: 0; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 36px 14px #F6F3EC; mask-image: linear-gradient(to bottom, #000 0% 58%, transparent 74%); -webkit-mask-image: linear-gradient(to bottom, #000 0% 58%, transparent 74%)"></div>
</div>
</div>
</section>

<Wave from="#F6F3EC" to="#E1EAD9" shape="rise" />
<section style="background: #E1EAD9">
<div style="max-width: 1200px; margin: 0 auto; padding: 32px 24px 80px; display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; max-width: 720px; margin: 0 auto">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46">Lorem ipsum</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; color: #33503F">Rooted, flowing, <em style="font-style: italic">in balance</em></h2>
<p style="margin: 0; color: #4A463E">Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px">
<div style="background: #F3F6EF; border-radius: 40px 28px 28px 28px; padding: 32px; display: flex; flex-direction: column; gap: 14px">
<span style="width: 60px; height: 60px; border-radius: 50%; background: #E1EAD9; display: flex; align-items: center; justify-content: center"><svg width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11M14 14c-3 2-6 3-9 3M14 14c3 2 6 3 9 3M14 14v10M14 18c-2 2-4 4-7 5M14 18c2 2 4 4 7 5"></path></svg></span>
<h3 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 25px; color: #33503F">Roots</h3>
<p style="margin: 0; color: #4A463E">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
</div>
<div style="background: #F3F6EF; border-radius: 28px 40px 28px 28px; padding: 32px; display: flex; flex-direction: column; gap: 14px">
<span style="width: 60px; height: 60px; border-radius: 50%; background: #D7E7E3; display: flex; align-items: center; justify-content: center"><svg width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9c3-2 5-2 8 0s5 2 8 0 5-2 6-1M3 15c3-2 5-2 8 0s5 2 8 0 5-2 6-1M3 21c3-2 5-2 8 0s5 2 8 0 5-2 6-1"></path></svg></span>
<h3 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 25px; color: #33503F">Flow</h3>
<p style="margin: 0; color: #4A463E">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute.</p>
</div>
<div style="background: #F3F6EF; border-radius: 28px 28px 40px 28px; padding: 32px; display: flex; flex-direction: column; gap: 14px">
<span style="width: 60px; height: 60px; border-radius: 50%; background: #EFE4D6; display: flex; align-items: center; justify-content: center"><svg width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22C6 12 12 6 23 5c0 11-6 17-17 17Z"></path><path d="M6 22 16 12"></path></svg></span>
<h3 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 25px; color: #33503F">Balance</h3>
<p style="margin: 0; color: #4A463E">Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
</div>
</div>
</div>
</section>
<Wave from="#E1EAD9" to="#F6F3EC" shape="fall" />

<section style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 88px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 620px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46">{t('navServices')}</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; color: #33503F">Lorem ipsum dolor sit amet</h2>
</div>
<a href={localePath('/services', lang)} style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 4px; font-weight: 600; text-decoration: none; color: #33503F">{t('allServices')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#33503F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px">
<a href={localePath('/services', lang)} style="text-decoration: none; color: #3A3631; background: #EFE4D6; border-radius: 40px 28px 28px 28px; padding: 28px; display: flex; flex-direction: column; gap: 14px; min-height: 260px">
<span style="width: 56px; height: 56px; border-radius: 50%; background: #F6F3EC; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="6" r="2.5"></circle><path d="M14 9v8M9 12h10M14 17l-4 7M14 17l4 7"></path></svg></span>
<span style="font-family: Fraunces, Georgia, serif; font-size: 23px; font-weight: 500; color: #33503F">Lorem ipsum</span>
<span style="color: #4A463E; flex-grow: 1">Dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.</span>
<span style="font-weight: 600; color: #7A5C46">{t('learnMore')} →</span>
</a>
<a href={localePath('/services', lang)} style="text-decoration: none; color: #3A3631; background: #EFE4D6; border-radius: 28px 40px 28px 28px; padding: 28px; display: flex; flex-direction: column; gap: 14px; min-height: 260px">
<span style="width: 56px; height: 56px; border-radius: 50%; background: #F6F3EC; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 24V13M14 13c0-4-3-7-8-7 0 4 3 7 8 7ZM14 16c0-4 3-7 8-7 0 4-3 7-8 7Z"></path></svg></span>
<span style="font-family: Fraunces, Georgia, serif; font-size: 23px; font-weight: 500; color: #33503F">Consectetur elit</span>
<span style="color: #4A463E; flex-grow: 1">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</span>
<span style="font-weight: 600; color: #7A5C46">{t('learnMore')} →</span>
</a>
<a href={localePath('/services', lang)} style="text-decoration: none; color: #3A3631; background: #EFE4D6; border-radius: 28px 28px 40px 28px; padding: 28px; display: flex; flex-direction: column; gap: 14px; min-height: 260px">
<span style="width: 56px; height: 56px; border-radius: 50%; background: #F6F3EC; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 23s-9-5.5-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.5-9 12-9 12Z"></path></svg></span>
<span style="font-family: Fraunces, Georgia, serif; font-size: 23px; font-weight: 500; color: #33503F">Sed do eiusmod</span>
<span style="color: #4A463E; flex-grow: 1">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum.</span>
<span style="font-weight: 600; color: #7A5C46">{t('learnMore')} →</span>
</a>
<a href={localePath('/services', lang)} style="text-decoration: none; color: #3A3631; background: #EFE4D6; border-radius: 28px 28px 28px 40px; padding: 28px; display: flex; flex-direction: column; gap: 14px; min-height: 260px">
<span style="width: 56px; height: 56px; border-radius: 50%; background: #F6F3EC; display: flex; align-items: center; justify-content: center"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22 11 9l5 7 3-4 6 10Z"></path></svg></span>
<span style="font-family: Fraunces, Georgia, serif; font-size: 23px; font-weight: 500; color: #33503F">Tempor incidunt</span>
<span style="color: #4A463E; flex-grow: 1">Excepteur sint occaecat cupidatat non proident, sunt in culpa.</span>
<span style="font-weight: 600; color: #7A5C46">{t('learnMore')} →</span>
</a>
</div>
</section>

<Wave from="#F6F3EC" to="#EFE4D6" shape="ripple" />
<ReviewCarousel lang={lang} />
<Wave from="#EFE4D6" to="#F6F3EC" shape="drift" />

<section style="max-width: 1200px; margin: 0 auto; padding: 48px 24px 96px; display: flex; flex-wrap: wrap; align-items: center; gap: 64px">
<div style="flex: 1 1 360px; min-width: 0; display: flex; justify-content: center">
<div style="width: 100%; max-width: 440px; aspect-ratio: 1 / 1; border-radius: 46% 54% 40% 60% / 55% 42% 58% 45%; background: #D9C3AA; display: flex; align-items: center; justify-content: center">
<span style="padding: 8px 16px; border-radius: 999px; background: #F6F3EC; font-size: 13px; color: #4A463E">{t('photoTreatmentRoom')}</span>
</div>
</div>
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46">{t('navAbout')}</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; color: #33503F">Lorem ipsum, <em style="font-style: italic">dolor sit</em> amet</h2>
<p style="margin: 0; color: #4A463E">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus posuere velit aliquet. Donec ullamcorper nulla non metus auctor fringilla.</p>
<p style="margin: 0; color: #4A463E">Cras mattis consectetur purus sit amet fermentum. Maecenas faucibus mollis interdum, vestibulum id ligula porta felis euismod semper.</p>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<span style="padding: 8px 14px; border-radius: 999px; background: #E1EAD9; color: #33503F; font-size: 14px; font-weight: 500">D.O. — [School]</span>
<span style="padding: 8px 14px; border-radius: 999px; background: #E1EAD9; color: #33503F; font-size: 14px; font-weight: 500">[Association] member</span>
<span style="padding: 8px 14px; border-radius: 999px; background: #E1EAD9; color: #33503F; font-size: 14px; font-weight: 500">Français · English</span>
</div>
<a href={localePath('/about', lang)} style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 12px 0; font-weight: 600; text-decoration: none; color: #33503F">{t('readHerStory')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#33503F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</section>

<Wave from="#F6F3EC" to="#2F4A3A" shape="rise" opacity={0.35} />
<section style="background: #2F4A3A">
<div style="max-width: 760px; margin: 0 auto; padding: 40px 24px 72px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; color: #F6F3EC">Lorem ipsum dolor <em style="font-style: italic; color: #D9C3AA">sit amet?</em></h2>
<p style="margin: 0; color: #CFDCC6; font-size: 18px">Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam nihil molestiae consequatur.</p>
<a href={site.goRendezVousUrl} data-book-now style="margin-top: 8px; display: inline-flex; align-items: center; gap: 10px; padding: 16px 28px; border-radius: 999px; background: #E1EAD9; color: #2F4A3A; text-decoration: none; font-weight: 600">{t('seeAvailabilities')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2F4A3A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</section>
</main>
</BaseLayout>
