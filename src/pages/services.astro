---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout title={t('titleServices')} description={t('descriptionServices')} current="services" lang={lang}>
<main>
<section style="background: #E1EAD9; position: relative; overflow: hidden">
<svg viewBox="0 0 400 400" aria-hidden="true" style="position: absolute; right: -60px; top: -40px; width: 420px; height: 420px" fill="none" stroke="#C9D8BE" stroke-width="1.5"><ellipse cx="200" cy="200" rx="40" ry="36"></ellipse><ellipse cx="196" cy="204" rx="80" ry="72"></ellipse><ellipse cx="192" cy="208" rx="122" ry="110"></ellipse><ellipse cx="188" cy="212" rx="164" ry="150"></ellipse><ellipse cx="184" cy="216" rx="206" ry="190"></ellipse></svg>
<div style="position: relative; max-width: 1200px; margin: 0 auto; padding: 56px 24px 40px; display: flex; flex-direction: column; gap: 18px; max-width: 1200px">
<span style="display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46"><span style="width: 28px; height: 2px; background: #7A5C46; border-radius: 2px"></span>{t('navServices')}</span>
<h1 style="margin: 0; max-width: 760px; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(40px, 5vw, 66px); line-height: 1.05; letter-spacing: -0.015em; color: #33503F">Lorem ipsum dolor sit <em style="font-style: italic; color: #7A5C46">amet</em></h1>
<p style="margin: 0; max-width: 600px; font-size: 19px; color: #4A463E">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam.</p>
</div>
</section>
<Wave from="#E1EAD9" to="#F6F3EC" shape="fall" />

<section aria-label={t('serviceList')} style="max-width: 1100px; margin: 0 auto; padding: 32px 24px 80px; display: flex; flex-direction: column">

<article style="display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding: 24px 0">
<div style="flex: 0 0 220px; height: 200px; border-radius: 58% 42% 47% 53% / 46% 52% 48% 54%; background: #E1EAD9; display: flex; align-items: center; justify-content: center"><svg width="72" height="72" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="6" r="2.5"></circle><path d="M14 9v8M9 12h10M14 17l-4 7M14 17l4 7"></path></svg></div>
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: Fraunces, Georgia, serif; font-size: 18px; color: #7A5C46">01</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: 34px; line-height: 1.15; color: #33503F">Lorem ipsum dolor</h2>
<p style="margin: 0; color: #4A463E">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px">
<span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C"><svg width="16" height="16" viewBox="0 0 28 28" fill="none" stroke="#4F3B2C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="10"></circle><path d="M14 8v6l4 3"></path></svg>[60] min</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">[$000]</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">{t('insuranceReceipt')}</span>
</div>
</div>
</article>
<svg viewBox="0 0 1100 24" preserveAspectRatio="none" aria-hidden="true" style="display: block; width: 100%; height: 24px; margin: 16px 0"><path d="M0,12 C140,0 280,24 420,12 S700,0 840,12 S1020,24 1100,12" fill="none" stroke="#D9C3AA" stroke-width="1.5"></path></svg>

<article style="display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 48px; padding: 24px 0">
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: Fraunces, Georgia, serif; font-size: 18px; color: #7A5C46">02</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: 34px; line-height: 1.15; color: #33503F">Consectetur adipiscing</h2>
