<div style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px">
<span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C"><svg width="16" height="16" viewBox="0 0 28 28" fill="none" stroke="#4F3B2C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="10"></circle><path d="M14 8v6l4 3"></path></svg>[45] min</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">[$000]</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">{t('insuranceReceipt')}</span>
</div>
</div>
<div style="flex: 0 0 220px; height: 200px; border-radius: 46% 54% 40% 60% / 55% 42% 58% 45%; background: #EFE4D6; display: flex; align-items: center; justify-content: center"><svg width="72" height="72" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 24V13M14 13c0-4-3-7-8-7 0 4 3 7 8 7ZM14 16c0-4 3-7 8-7 0 4-3 7-8 7Z"></path></svg></div>
</article>
<svg viewBox="0 0 1100 24" preserveAspectRatio="none" aria-hidden="true" style="display: block; width: 100%; height: 24px; margin: 16px 0"><path d="M0,12 C140,24 280,0 420,12 S700,24 840,12 S1020,0 1100,12" fill="none" stroke="#C9D8BE" stroke-width="1.5"></path></svg>

<article style="display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding: 24px 0">
<div style="flex: 0 0 220px; height: 200px; border-radius: 52% 48% 60% 40% / 44% 56% 44% 56%; background: #D7E7E3; display: flex; align-items: center; justify-content: center"><svg width="72" height="72" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 23s-9-5.5-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.5-9 12-9 12Z"></path></svg></div>
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: Fraunces, Georgia, serif; font-size: 18px; color: #7A5C46">03</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: 34px; line-height: 1.15; color: #33503F">Sed do eiusmod tempor</h2>
<p style="margin: 0; color: #4A463E">Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px">
<span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C"><svg width="16" height="16" viewBox="0 0 28 28" fill="none" stroke="#4F3B2C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="10"></circle><path d="M14 8v6l4 3"></path></svg>[60] min</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">[$000]</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">{t('insuranceReceipt')}</span>
</div>
</div>
</article>
<svg viewBox="0 0 1100 24" preserveAspectRatio="none" aria-hidden="true" style="display: block; width: 100%; height: 24px; margin: 16px 0"><path d="M0,12 C140,0 280,24 420,12 S700,0 840,12 S1020,24 1100,12" fill="none" stroke="#D9C3AA" stroke-width="1.5"></path></svg>

<article style="display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 48px; padding: 24px 0">
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: Fraunces, Georgia, serif; font-size: 18px; color: #7A5C46">04</span>
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: 34px; line-height: 1.15; color: #33503F">Ut labore et dolore</h2>
<p style="margin: 0; color: #4A463E">Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam nihil molestiae consequatur, vel illum qui dolorem eum fugiat quo voluptas nulla pariatur.</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px">
<span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C"><svg width="16" height="16" viewBox="0 0 28 28" fill="none" stroke="#4F3B2C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="10"></circle><path d="M14 8v6l4 3"></path></svg>[60] min</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">[$000]</span>
<span style="padding: 6px 14px; border-radius: 999px; background: #EFE4D6; font-size: 14px; color: #4F3B2C">{t('insuranceReceipt')}</span>
</div>
</div>
<div style="flex: 0 0 220px; height: 200px; border-radius: 60% 40% 52% 48% / 48% 58% 42% 52%; background: #E1EAD9; display: flex; align-items: center; justify-content: center"><svg width="72" height="72" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 22 11 9l5 7 3-4 6 10Z"></path></svg></div>
</article>
</section>

<Wave from="#F6F3EC" to="#EFE4D6" shape="ripple" />
<section style="background: #EFE4D6">
<div style="max-width: 1200px; margin: 0 auto; padding: 32px 24px 80px; display: flex; flex-direction: column; gap: 48px">
