---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout title={t('titleOsteopathy')} description={t('descriptionOsteopathy')} current="osteopathy" lang={lang}>
<main>
<section style="max-width: 1200px; margin: 0 auto; padding: 32px 24px 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<span style="display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46"><span style="width: 28px; height: 2px; background: #7A5C46; border-radius: 2px"></span>{t('foundations')}</span>
<h1 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(40px, 5vw, 66px); line-height: 1.05; letter-spacing: -0.015em; color: #33503F">{t('osteopathyHeadline')}</h1>
<p style="margin: 0; font-size: 19px; color: #4A463E; max-width: 540px">{t('osteopathyLead')}</p>
</div>
<div style="flex: 1 1 380px; min-width: 0; display: flex; justify-content: center">
<svg viewBox="0 0 480 440" aria-hidden="true" style="width: 100%; max-width: 480px; height: auto">
<ellipse cx="240" cy="220" rx="230" ry="210" fill="#EFE4D6"></ellipse>
<circle cx="190" cy="130" r="62" fill="#C9D8BE"></circle>
<circle cx="290" cy="120" r="70" fill="#B3C7A7"></circle>
<circle cx="240" cy="78" r="58" fill="#C9D8BE"></circle>
<circle cx="160" cy="180" r="44" fill="#B3C7A7"></circle>
<circle cx="320" cy="185" r="48" fill="#C9D8BE"></circle>
<circle cx="240" cy="160" r="52" fill="#E1EAD9"></circle>
<path d="M228,312 C232,262 230,212 236,178 L246,178 C250,212 248,262 254,312 Z" fill="#A88A6E"></path>
<path d="M236,214 C222,206 208,196 198,178 M246,232 C262,220 276,210 286,192" fill="none" stroke="#A88A6E" stroke-width="5" stroke-linecap="round"></path>
<path d="M232,310 C210,322 186,330 150,334 M240,312 C232,330 222,346 206,360 M246,312 C256,330 268,344 288,356 M252,310 C276,322 302,328 334,330" fill="none" stroke="#A88A6E" stroke-width="3.5" stroke-linecap="round"></path>
<path d="M40,350 C110,330 170,372 240,352 S370,332 440,352 L440,392 C370,372 310,412 240,392 S110,372 40,392 Z" fill="#D7E7E3"></path>
<path d="M70,366 C120,354 170,380 220,370 M260,374 C310,362 360,382 410,370" fill="none" stroke="#9EC2BB" stroke-width="2" stroke-linecap="round"></path>
</svg>
</div>
</section>

<section style="max-width: 760px; margin: 0 auto; padding: 16px 24px 88px; display: flex; flex-direction: column; gap: 44px">
<div style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(26px, 3vw, 34px); line-height: 1.25; color: #33503F; text-decoration: underline; text-decoration-color: #B3C7A7; text-decoration-thickness: 1.5px; text-underline-offset: 7px">{t('stillTitle')}</h2>
<p style="margin: 0; color: #4A463E"><strong style="font-weight: 600; color: #33503F">{t('stillName')}</strong>, {t('stillBody')}</p>
<p style="margin: 0; color: #4A463E">{t('principlesIntro')}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px">
<li style="font-family: Fraunces, Georgia, serif; font-size: 20px; line-height: 1.35; color: #33503F">{t('principle1')}</li>
<li style="font-family: Fraunces, Georgia, serif; font-size: 20px; line-height: 1.35; color: #33503F">{t('principle2')}</li>
<li style="font-family: Fraunces, Georgia, serif; font-size: 20px; line-height: 1.35; color: #33503F">{t('principle3')}</li>
<li style="font-family: Fraunces, Georgia, serif; font-size: 20px; line-height: 1.35; color: #33503F">{t('principle4')}</li>
</ul>
</div>
<div style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(26px, 3vw, 34px); line-height: 1.25; color: #33503F; text-decoration: underline; text-decoration-color: #B3C7A7; text-decoration-thickness: 1.5px; text-underline-offset: 7px">{t('sutherlandTitle')}</h2>
<p style="margin: 0; color: #4A463E"><strong style="font-weight: 600; color: #33503F">{t('sutherlandName')}</strong></p>
<p style="margin: 0; color: #4A463E">{t('sutherlandP1')}</p>
<p style="margin: 0; color: #4A463E">{t('sutherlandP2')}</p>
</div>
</section>

<Wave from="#F6F3EC" to="#2F4A3A" shape="rise" opacity={0.35} />
<section style="background: #2F4A3A">
<div style="max-width: 760px; margin: 0 auto; padding: 40px 24px 72px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; color: #F6F3EC">{t('aboutCtaHeadline')} <em style="font-style: italic; color: #D9C3AA">{t('aboutCtaEmphasis')}</em></h2>
<p style="margin: 0; color: #CFDCC6; font-size: 18px">{t('aboutCtaBody')}</p>
<a href={site.goRendezVousUrl} data-book-now style="margin-top: 8px; display: inline-flex; align-items: center; gap: 10px; padding: 16px 28px; border-radius: 999px; background: #E1EAD9; color: #2F4A3A; text-decoration: none; font-weight: 600">{t('seeAvailabilities')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2F4A3A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</section>
</main>
</BaseLayout>
