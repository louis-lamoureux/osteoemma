---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
---
<BaseLayout title="Book — Lorem Ipsum, Osteopath" current="booking">
<main>
<section style="background: #E1EAD9">
<div style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 24px; display: flex; flex-direction: column; gap: 16px">
<span style="display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46"><span style="width: 28px; height: 2px; background: #7A5C46; border-radius: 2px"></span>Book an appointment</span>
<h1 style="margin: 0; max-width: 760px; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(40px, 5vw, 62px); line-height: 1.05; letter-spacing: -0.015em; color: #33503F">Lorem ipsum, <em style="font-style: italic; color: #7A5C46">find your time</em></h1>
<p style="margin: 0; max-width: 600px; font-size: 19px; color: #4A463E">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium.</p>
</div>
</section>
<Wave from="#E1EAD9" to="#F6F3EC" shape="fall" />

<section style="max-width: 1200px; margin: 0 auto; padding: 16px 24px 88px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">

<aside style="flex: 0 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<div style="background: #EFE4D6; border-radius: 40px 28px 28px 28px; padding: 28px; display: flex; flex-direction: column; gap: 16px">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: 28px; color: #33503F">The clinic</h2>
<div style="width: 100%; aspect-ratio: 16 / 10; border-radius: 52% 48% 46% 54% / 40% 44% 56% 60%; background: #D9C3AA; display: flex; align-items: center; justify-content: center"><span style="padding: 6px 14px; border-radius: 999px; background: #F6F3EC; font-size: 13px; color: #4A463E">Map</span></div>
<div style="display: flex; gap: 12px; align-items: flex-start; color: #4F3B2C"><svg width="22" height="22" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 22px; margin-top: 3px"><path d="M14 25s8-7.5 8-13a8 8 0 0 0-16 0c0 5.5 8 13 8 13Z"></path><circle cx="14" cy="12" r="3"></circle></svg><span>[0000, rue Lorem], suite [000]<br>Montréal (QC) H0H 0H0</span></div>
<div style="display: flex; gap: 12px; align-items: center; color: #4F3B2C"><svg width="22" height="22" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 22px"><path d="M6 4h4l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 4 6a2 2 0 0 1 2-2Z"></path></svg><a href="#" style="color: #4F3B2C; text-decoration: none">[514 000-0000]</a></div>
<div style="display: flex; gap: 12px; align-items: center; color: #4F3B2C"><svg width="22" height="22" viewBox="0 0 28 28" fill="none" stroke="#7A5C46" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 22px"><rect x="4" y="7" width="20" height="14" rx="2"></rect><path d="m4 8 10 7 10-7"></path></svg><a href="#" style="color: #4F3B2C; text-decoration: none">[hello@lorem.ca]</a></div>
<svg viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true" style="display: block; width: 100%; height: 16px"><path d="M0,8 C40,0 80,16 120,8 S200,0 240,8 S290,16 300,8" fill="none" stroke="#D9C3AA" stroke-width="1.5"></path></svg>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 12px; font-size: 15px; color: #4F3B2C">
<span>Mon–Thu</span><span style="text-align: right">[9:00–19:00]</span>
<span>Friday</span><span style="text-align: right">[9:00–15:00]</span>
<span>Sat–Sun</span><span style="text-align: right">Closed</span>
</div>
</div>
<div style="background: #F3F6EF; border-radius: 28px; padding: 24px 26px; display: flex; flex-direction: column; gap: 8px">
<span style="font-family: Fraunces, Georgia, serif; font-size: 21px; color: #33503F">Cancellation policy</span>
<p style="margin: 0; font-size: 15px; color: #4A463E">Lorem ipsum dolor sit amet, [24] hours consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.</p>
</div>
<div style="background: #F3F6EF; border-radius: 28px; padding: 24px 26px; display: flex; flex-direction: column; gap: 8px">
<span style="font-family: Fraunces, Georgia, serif; font-size: 21px; color: #33503F">Before your visit</span>
<p style="margin: 0; font-size: 15px; color: #4A463E">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo.</p>
</div>
</aside>
</section>
</main>
</BaseLayout>
