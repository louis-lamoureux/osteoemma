---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Wave from '../components/Wave.astro';
import GoRendezVousWidget from '../components/GoRendezVousWidget.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, type PageKey } from '../data/site';
import { swapLocale, useTranslations, type Locale } from '../i18n/utils';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  current: PageKey;
  lang: Locale;
}

/**
 * Per-page header colours and the wave that leads into the footer.
 * The header blends into each page's hero; the footer wave starts from
 * whatever colour the page's last section ends on.
 */
const themes: Record<PageKey, {
  headerBg: string;
  logoFill: string;
  activeBg: string;
  footerFrom: string;
  footerShape: 'rise' | 'fall' | 'ripple' | 'drift';
  footerOpacity: number;
}> = {
  home:       { headerBg: '#F6F3EC', logoFill: '#E1EAD9', activeBg: '#E1EAD9', footerFrom: '#2F4A3A', footerShape: 'fall',   footerOpacity: 0.45 },
  services:   { headerBg: '#E1EAD9', logoFill: '#F3F6EF', activeBg: '#F3F6EF', footerFrom: '#2F4A3A', footerShape: 'fall',   footerOpacity: 0.45 },
  about:      { headerBg: '#EFE4D6', logoFill: '#E1EAD9', activeBg: '#F6F3EC', footerFrom: '#2F4A3A', footerShape: 'fall',   footerOpacity: 0.45 },
  osteopathy: { headerBg: '#F6F3EC', logoFill: '#E1EAD9', activeBg: '#E1EAD9', footerFrom: '#2F4A3A', footerShape: 'fall',   footerOpacity: 0.45 },
  booking:    { headerBg: '#E1EAD9', logoFill: '#F3F6EF', activeBg: '#F3F6EF', footerFrom: '#F6F3EC', footerShape: 'ripple', footerOpacity: 0.55 },
};

const {
  title,
  description,
  current,
  lang,
} = Astro.props;
const t = themes[current];
const translate = useTranslations(lang);
const metaDescription = description ?? translate('description');
const pathname = Astro.url.pathname;
const origin = (Astro.site ?? Astro.url).toString().replace(/\/$/, '');
const canonical = new URL(pathname, `${origin}/`).href;
const hrefFr = new URL(swapLocale(pathname, 'fr'), `${origin}/`).href;
const hrefEn = new URL(swapLocale(pathname, 'en'), `${origin}/`).href;
const htmlLang = lang === 'fr' ? 'fr-CA' : 'en-CA';
const ogLocale = lang === 'fr' ? 'fr_CA' : 'en_CA';
const ogLocaleAlt = lang === 'fr' ? 'en_CA' : 'fr_CA';
---
<!doctype html>
<html lang={htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={metaDescription}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="fr-CA" href={hrefFr}>
<link rel="alternate" hreflang="en-CA" href={hrefEn}>
<link rel="alternate" hreflang="x-default" href={hrefFr}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={metaDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={ogLocale}>
<meta property="og:locale:alternate" content={ogLocaleAlt}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={metaDescription}>
<JsonLd title={title} description={metaDescription} practiceDescription={translate('descriptionHome')} lang={lang} canonical={canonical} origin={origin} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Figtree:wght@400;500;600&display=swap">
</head>
<body>
<div style="font-family: Figtree, system-ui, sans-serif; color: #3A3631; background: #F6F3EC; font-size: 17px; line-height: 1.65">
<Header current={current} lang={lang} bg={t.headerBg} logoFill={t.logoFill} activeBg={t.activeBg} />
<slot />
<Wave from={t.footerFrom} to="#EFE4D6" shape={t.footerShape} opacity={t.footerOpacity} />
<Footer lang={lang} />
<GoRendezVousWidget lang={lang} />
</div>
</body>
</html>

<style is:global>
body{margin:0;background:#F6F3EC}
a{color:#33503F}a:hover{color:#7A5C46}
@media (max-width: 700px) {
  body { overflow-x: clip; }
  header nav {
    padding: 16px 20px 12px !important;
    gap: 14px !important;
  }
  header nav > div {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    gap: 8px !important;
  }
  header nav > div > a {
    margin: 0 !important;
    width: 100%;
    min-height: 44px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
  }
  header nav > div > a[data-book-now] {
    grid-column: 1 / -1;
    padding: 14px 22px !important;
  }
  header nav > div > span {
    grid-column: 1 / -1;
    margin: 0 !important;
    justify-content: center;
    min-height: 44px;
  }
  main h1 {
    font-size: clamp(34px, 11vw, 46px) !important;
  }
  main a[style*="border-radius: 999px"] {
    flex: 1 1 100%;
    justify-content: center;
    box-sizing: border-box;
    min-height: 48px;
    text-align: center;
  }
  main article > div[style*="flex: 0 0 220px"] {
    flex: 1 1 100% !important;
    width: 100% !important;
    max-width: none !important;
    height: 180px !important;
  }
  footer > div > div:first-child > div {
    flex: 1 1 100% !important;
    max-width: none !important;
  }
}
</style>
