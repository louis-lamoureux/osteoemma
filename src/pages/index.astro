<div style="position: absolute; left: 0; bottom: 28px; background: #FFFFFF; border-radius: 20px; padding: 14px 20px 14px 14px; box-shadow: 0 14px 36px rgba(51, 80, 63, 0.14); display: flex; gap: 14px; align-items: center">
<span style="width: 46px; height: 46px; border-radius: 50%; background: #E1EAD9; display: flex; align-items: center; justify-content: center"><svg width="24" height="24" viewBox="0 0 28 28" fill="none" stroke="#33503F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="6" width="20" height="18" rx="3"></rect><path d="M4 11h20M10 3v5M18 3v5"></path></svg></span>
