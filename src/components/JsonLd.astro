---
import { geo, mapUrl, site } from '../data/site';
import { luminoProfileUrl } from '../data/reviews';
import type { Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  practiceDescription: string;
  lang: Locale;
  canonical: string;
  origin: string;
}

const { title, description, practiceDescription, lang, canonical, origin } = Astro.props;
const practiceId = `${origin}/#practice`;
const personId = `${origin}/#emmanuele`;
const clinicId = `${origin}/#hakini`;
const websiteId = `${origin}/#website`;
const image = `${origin}/og.jpg`;
const schools = {
  brussels: 'Université de Bruxelles',
  quebec: 'Institut d’Enseignement de l’Ostéopathie du Québec',
  nutrition:
    'Centre Européen pour la Recherche, le Développement et l’Enseignement de la Nutrition et de la Nutrithérapie',
};
const school = (name: string) => ({ '@type': 'EducationalOrganization', name });
const credential = (name: string, schoolName: string) => ({
  '@type': 'EducationalOccupationalCredential',
  name,
  recognizedBy: school(schoolName),
});

const address = {
  '@type': 'PostalAddress',
  streetAddress: site.address.street,
  addressLocality: site.address.locality,
  addressRegion: site.address.region,
  postalCode: site.address.postalCode,
  addressCountry: site.address.country,
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: `${site.name}, ${lang === 'fr' ? 'ostéopathe' : 'osteopath'}`,
      url: `${origin}/`,
      inLanguage: ['fr-CA', 'en-CA'],
      publisher: { '@id': personId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: lang === 'fr' ? 'fr-CA' : 'en-CA',
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: site.tagline,
      url: `${origin}/`,
      image,
      knowsLanguage: ['fr', 'en'],
      workLocation: { '@id': practiceId },
      worksFor: { '@id': clinicId },
      alumniOf: [school(schools.brussels), school(schools.quebec), school(schools.nutrition)],
      hasCredential: [
        credential('Physiothérapie (Université de Bruxelles)', schools.brussels),
        credential('Ostéopathie (Institut d’Enseignement de l’Ostéopathie du Québec)', schools.quebec),
        credential('Nutrithérapeute et Conseiller en Nutrition humaine', schools.nutrition),
      ],
      sameAs: [luminoProfileUrl],
    },
    {
      '@type': 'LocalBusiness',
      '@id': practiceId,
      name: site.name,
      description: practiceDescription,
      url: `${origin}/`,
      image,
      telephone: '+15148862946',
      address,
      geo: {
        '@type': 'GeoCoordinates',
        latitude: geo.latitude,
        longitude: geo.longitude,
      },
      hasMap: mapUrl,
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Verdun' },
        { '@type': 'City', name: 'Montréal' },
      ],
      currenciesAccepted: 'CAD',
      potentialAction: {
        '@type': 'ReserveAction',
        name: lang === 'fr' ? 'Prendre rendez-vous' : 'Book an appointment',
        target: site.goRendezVousUrl,
      },
    },
    {
      '@type': 'Organization',
      '@id': clinicId,
      name: site.clinic.name,
      url: site.clinic.url,
    },
  ],
};

const json = JSON.stringify(graph).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json}></script>
