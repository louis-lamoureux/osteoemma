<a href="/services" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 4px; font-weight: 600; text-decoration: none; color: #33503F">All services <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#33503F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
