---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import { site } from '../data/site';
import portrait from '../assets/provider.png';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang?: Locale;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout title={t('titleAbout')} description={t('descriptionAbout')} current="about" lang={lang}>
<main>
<section style="background: #EFE4D6">
<div style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px">
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<span style="display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #7A5C46"><span style="width: 28px; height: 2px; background: #7A5C46; border-radius: 2px"></span>{t('navAbout')}</span>
<h1 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(40px, 5vw, 66px); line-height: 1.05; letter-spacing: -0.015em; color: #33503F">{site.name}, <em style="font-style: italic; color: #7A5C46">D.O.</em></h1>
<p style="margin: 0; font-size: 19px; color: #4F3B2C; max-width: 540px">{t('aboutLead')}</p>
</div>
<div style="flex: 1 1 360px; min-width: 0; display: flex; justify-content: center">
<div style="width: 100%; max-width: 420px; aspect-ratio: 4 / 5; border-radius: 46% 54% 40% 60% / 55% 42% 58% 45%; background: #EFE4D6; position: relative; overflow: hidden">
<img src={portrait.src} width={portrait.width} height={portrait.height} alt={t('portraitAlt')} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 22%">
<div aria-hidden="true" style="position: absolute; inset: 0; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 36px 14px #EFE4D6; mask-image: linear-gradient(to bottom, #000 0% 58%, transparent 74%); -webkit-mask-image: linear-gradient(to bottom, #000 0% 58%, transparent 74%)"></div>
</div>
</div>
</div>
</section>
<Wave from="#EFE4D6" to="#F6F3EC" shape="drift" />

<section style="max-width: 760px; margin: 0 auto; padding: 48px 24px 88px; display: flex; flex-direction: column; gap: 44px">
<div style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(26px, 3vw, 34px); line-height: 1.25; color: #33503F; text-decoration: underline; text-decoration-color: #B3C7A7; text-decoration-thickness: 1.5px; text-underline-offset: 7px">{t('formationTitle')}</h2>
<p style="margin: 0; color: #4A463E">{t('formationIntro')} <strong style="font-weight: 600; color: #33503F">{t('formationDegrees')}</strong> {t('formationBridge')} <strong style="font-weight: 600; color: #33503F">{t('formationNutrition')}</strong></p>
</div>
<div style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(26px, 3vw, 34px); line-height: 1.25; color: #33503F; text-decoration: underline; text-decoration-color: #B3C7A7; text-decoration-thickness: 1.5px; text-underline-offset: 7px">{t('experienceTitle')}</h2>
<p style="margin: 0; color: #4A463E"><strong style="font-weight: 600; color: #33503F">{t('experienceClinic')}</strong> {t('experienceMiddle')} <strong style="font-weight: 600; color: #33503F">{t('experienceServices')}</strong></p>
<p style="margin: 0; color: #4A463E">{t('experienceNowBefore')} <strong style="font-weight: 600; color: #33503F">{t('experienceNowRole')}</strong> {t('experienceNowAfter')}</p>
</div>
<div style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: clamp(26px, 3vw, 34px); line-height: 1.25; color: #33503F; text-decoration: underline; text-decoration-color: #B3C7A7; text-decoration-thickness: 1.5px; text-underline-offset: 7px">{t('furtherTitle')}</h2>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; color: #4A463E">
<li><strong style="font-weight: 600; color: #33503F">{t('further1Name')}</strong> {t('further1Detail')}</li>
<li><strong style="font-weight: 600; color: #33503F">{t('further2Name')}</strong> {t('further2Detail')}</li>
<li><strong style="font-weight: 600; color: #33503F">{t('further3Name')}</strong> {t('further3Detail')}</li>
<li><strong style="font-weight: 600; color: #33503F">{t('further4Name')}</strong> {t('further4Detail')}</li>
</ul>
</div>
</section>

<Wave from="#F6F3EC" to="#2F4A3A" shape="rise" opacity={0.35} />
<section style="background: #2F4A3A">
<div style="max-width: 760px; margin: 0 auto; padding: 40px 24px 72px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center">
<h2 style="margin: 0; font-family: Fraunces, Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; color: #F6F3EC">{t('aboutCtaHeadline')} <em style="font-style: italic; color: #D9C3AA">{t('aboutCtaEmphasis')}</em></h2>
<p style="margin: 0; color: #CFDCC6; font-size: 18px">{t('aboutCtaBody')}</p>
<a href={site.goRendezVousUrl} data-book-now style="margin-top: 8px; display: inline-flex; align-items: center; gap: 10px; padding: 16px 28px; border-radius: 999px; background: #E1EAD9; color: #2F4A3A; text-decoration: none; font-weight: 600">{t('seeAvailabilities')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2F4A3A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</section>
</main>
</BaseLayout>
