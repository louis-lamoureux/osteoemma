---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wave from '../components/Wave.astro';
import { site } from '../data/site';
---
<BaseLayout title="Home — Lorem Ipsum, Osteopath" current="home">
<main>
<section style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 80px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px">
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
