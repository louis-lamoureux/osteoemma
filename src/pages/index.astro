<svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="position: absolute; inset: 0; width: 100%; height: 100%" fill="none" stroke="#B3C7A7" stroke-width="1.5"><ellipse cx="210" cy="230" rx="34" ry="30"></ellipse><ellipse cx="206" cy="232" rx="72" ry="64"></ellipse><ellipse cx="202" cy="236" rx="112" ry="100"></ellipse><ellipse cx="198" cy="240" rx="152" ry="138"></ellipse><ellipse cx="194" cy="244" rx="194" ry="178"></ellipse><ellipse cx="190" cy="248" rx="236" ry="220"></ellipse></svg>
